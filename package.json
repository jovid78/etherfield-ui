{
  "name": "@etherfield/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Etherfield component library: Foldkit views styled with Panda design tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./panda/config": "./src/panda/config.ts",
    "./panda/preset": "./src/panda/preset.ts",
    "./styled-system/*": {
      "types": "./styled-system/*/index.d.ts",
      "default": "./styled-system/*/index.js"
    },
    "./fonts.css": "./src/fonts.css",
    "./button": "./src/button.ts",
    "./heading": "./src/heading.ts",
    "./package.json": "./package.json",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "panda codegen --silent && panda lib",
    "prepare": "panda codegen --silent && panda lib",
    "typecheck": "panda codegen --silent && tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt"
  },
  "peerDependencies": {
    "@foldkit/ui": "0.171.0",
    "effect": "4.1.4",
    "foldkit": "0.171.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/bitter": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/michroma": "5.3.0",
    "@fontsource/space-mono": "5.3.0"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.1.4",
    "@foldkit/ui": "0.171.0",
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "effect": "4.1.4",
    "foldkit": "0.171.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  }
}
